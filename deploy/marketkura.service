# /etc/systemd/system/marketkura.service
[Unit]
Description=MarketKuraa (gunicorn)
After=network.target postgresql.service

[Service]
User=marketkura
WorkingDirectory=/srv/marketkura
EnvironmentFile=/srv/marketkura/.env
Environment=DJANGO_SETTINGS_MODULE=marketkura.settings.prod
ExecStart=/srv/marketkura/.venv/bin/gunicorn marketkura.wsgi:application --workers 3 --bind unix:/run/marketkura/gunicorn.sock
RuntimeDirectory=marketkura
Restart=on-failure

[Install]
WantedBy=multi-user.target
