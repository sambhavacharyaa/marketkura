DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Production database settings
DB_NAME=marketkura
DB_USER=marketkura
DB_PASSWORD=replace-with-database-password
DB_HOST=localhost
DB_PORT=5432
CSRF_TRUSTED_ORIGINS=https://example.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Optional: Google sign-in (OAuth client from Google Cloud Console).
# Authorised redirect URI: https://<your-domain>/auth/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Cloudflare Turnstile on signup/contact. Left unset, those forms skip the widget
# entirely (local dev works without a Cloudflare account).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional production extras
BEHIND_PROXY=True
USE_X_FORWARDED_FOR=True
REDIS_URL=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
DEFAULT_FROM_EMAIL=MarketKuraa <noreply@example.com>
